# Canonical public application origin.
# Production: set this to the exact HTTPS origin only, with no path/query/fragment.
# Example: https://app.example.com
# Development/Codespaces may omit this and use the local/forwarded request origin.
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Public Supabase browser/server configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public Cloudflare Turnstile site key used by the auth form.
# The corresponding secret belongs only in Supabase Auth CAPTCHA settings,
# never in NEXT_PUBLIC_ variables or the application repository.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only OpenAI credential.
# In production, use a dedicated project-scoped key with the minimum permissions needed by CoverLab.
# Store it in the deployment platform's encrypted secret store; never expose it through NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key

# Optional server-only OpenAI routing identifiers.
# Set these when the production key belongs to a specific OpenAI organization/project.
OPENAI_PROJECT_ID=your_openai_project_id
OPENAI_ORG_ID=your_openai_organization_id
